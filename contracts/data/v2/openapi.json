  "components": {
    "schemas": {
      "AssignmentInput": {
        "properties": {
          "problem": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Problem"
          },
          "department_id": {
            "type": "string",
            "format": "uuid",
            "title": "Department Id"
          },
          "intended_result": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 1,
            "title": "Intended Result"
          },
          "required_sections": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Required Sections"
          },
          "audience": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audience"
          },
          "constraints": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Constraints"
          },
          "selected_document_version_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Selected Document Version Ids"
          },
          "request_type": {
            "type": "string",
            "enum": [
              "problem",
              "RFP",
              "RFQ"
            ],
            "title": "Request Type",
            "default": "problem"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "problem",
          "department_id",
          "intended_result"
        ],
        "title": "AssignmentInput"
      },
      "Body_upload_api_v1_documents_post": {
        "properties": {
          "metadata": {
            "type": "string",
            "title": "Metadata"
          },
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "metadata",
          "file"
        ],
        "title": "Body_upload_api_v1_documents_post"
      },
      "Citation": {
        "properties": {
          "citation_id": {
            "type": "string",
            "title": "Citation Id"
          },
          "evidence_chunk_id": {
            "type": "string",
            "title": "Evidence Chunk Id"
          }
        },
        "type": "object",
        "required": [
          "citation_id",
          "evidence_chunk_id"
        ],
        "title": "Citation"
      },
      "ComparableInput": {
        "properties": {
          "topic": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Topic"
          },
          "department_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Department Id"
          },
          "specialty": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Specialty"
          },
          "for_external_model": {
            "type": "boolean",
            "title": "For External Model",
            "default": true
          },
          "limit": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 10
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ComparableInput"
      },
      "CorrectionInput": {
        "properties": {
          "expected_classification": {
            "type": "string",
            "enum": [
              "consulting",
              "operational",
              "unresolved"
            ],
            "title": "Expected Classification"
          },
          "classification": {
            "type": "string",
            "enum": [
              "consulting",
              "operational",
              "unresolved"
            ],
            "title": "Classification"
          },
          "reason": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Reason"
          }
