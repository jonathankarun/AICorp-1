      "FactInput": {
        "properties": {
          "engagement_id": {
            "type": "string",
            "format": "uuid",
            "title": "Engagement Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "specialty",
              "method",
              "deliverable",
              "recommendation",
              "outcome",
              "related_engagement",
              "contract_value"
            ],
            "title": "Kind"
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 10000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          },
          "unknown_reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Unknown Reason"
          },
          "evidence_chunk_id": {
            "type": "string",
            "format": "uuid",
            "title": "Evidence Chunk Id"
          },
          "related_engagement_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Related Engagement Id"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,16}|(?=[\\d.]{1,19}0*$)\\d{0,16}\\.\\d{0,2}0*$)"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount"
          },
          "currency": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Currency"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "engagement_id",
          "kind",
          "evidence_chunk_id"
        ],
        "title": "FactInput"
      },
