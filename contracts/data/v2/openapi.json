  "components": {
    "schemas": {
      "AssignmentInput": {
        "properties": {
          "problem": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Problem"
          },
          "department_id": {
            "type": "string",
            "format": "uuid",
            "title": "Department Id"
          },
          "intended_result": {
            "type": "string",
            "maxLength": 3000,
            "minLength": 1,
            "title": "Intended Result"
          },
          "required_sections": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Required Sections"
          },
          "audience": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audience"
          },
          "constraints": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Constraints"
          },
          "selected_document_version_ids": {
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Selected Document Version Ids"
          },
          "request_type": {
            "type": "string",
            "enum": [
              "problem",
              "RFP",
              "RFQ"
            ],
            "title": "Request Type",
            "default": "problem"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "problem",
          "department_id",
          "intended_result"
        ],
        "title": "AssignmentInput"
      },
      "Body_upload_api_v1_documents_post": {
        "properties": {
          "metadata": {
            "type": "string",
            "title": "Metadata"
          },
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "metadata",
          "file"
        ],
        "title": "Body_upload_api_v1_documents_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SearchInput": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query"
          },
          "selected_document_version_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "type": "array",
                "maxItems": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Document Version Ids"
          },
          "limit": {
            "type": "integer",
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 5
          },
          "for_external_model": {
            "type": "boolean",
            "title": "For External Model",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SearchInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
